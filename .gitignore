# ---------------------------------------------------------------------------
# Python / envs / build caches
# ---------------------------------------------------------------------------
.venv/
__pycache__/
*.pyc
*.egg-info/
.Rlib/

# ---------------------------------------------------------------------------
# Built distributable -- large artifact, regenerated by tools/build_dist.py. Never committed.
# ---------------------------------------------------------------------------
dist/

# ---------------------------------------------------------------------------
# Ephemeral runtime state + per-user secrets -- both live in their own top-level trees, so a
# single rule each keeps them out of git (and out of the dist). MUST never be committed.
# ---------------------------------------------------------------------------
runtime/
secrets/

# ---------------------------------------------------------------------------
# INTENTIONALLY TRACKED (do NOT ignore):
#   data/seasons/**  -> committed season history: draft results, projections, reference data,
#                       weekly pre/post-game + wrap-up summaries. Multi-year accumulation lives here.
#   assets/**        -> brand assets (e.g. cheese.png)
# Nothing sensitive lives under data/ anymore -- secrets/ and runtime/ are separate trees above.
# ---------------------------------------------------------------------------
